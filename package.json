{
  "name": "web-agent-chrome-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Universal AI web agent for Chrome — a side panel that reads and acts on any website through generic browser tools.",
  "scripts": {
    "dev": "npm run build -- --watch",
    "build": "tsc -b && vite build && vite build --config vite.content.config.ts",
    "build:fast": "vite build && vite build --config vite.content.config.ts",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@reduxjs/toolkit": "^2.13.0",
    "antd": "^5.29.3",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^6.30.6",
    "remark-gfm": "^4.0.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "typescript": "~5.6.3",
    "vite": "^6.4.4",
    "vitest": "^2.1.9"
  }
}
